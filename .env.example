# Copy this file to ".env" (same folder) and change the values.
# .env is git-ignored; this example file is committed.
#
# Passwords: at least 8 characters with upper case, lower case, a digit and a symbol.
# Avoid $ " ; # and spaces: Compose treats $ and # specially, and ; ends a value in a connection string.

# Password of the SQL Server "sa" (admin) account inside the container
SA_PASSWORD=ChangeMe_Sa2026!

# Password of the "english_app" login the API uses
APP_DB_PASSWORD=ChangeMe_App2026!

# PC port for the container's SQL Server. Not 1433, because the SQL Server installed on the PC already uses it.
DB_PORT=14330
